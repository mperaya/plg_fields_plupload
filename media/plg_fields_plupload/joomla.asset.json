{
  "$schema": "https://developer.joomla.org/schemas/json-schema/web_assets.json",
  "name": "plg_fields_plupload",
  "version": "3.0.0",
  "assets": [
    {
      "name": "plg_fields_plupload.style",
      "type": "style",
      "uri": "plg_fields_plupload/plupload.css",
      "dependencies": ["fontawesome"],
      "version": "3.0.0"
    },
    {
      "name": "plg_fields_plupload.jquery-ui.style",
      "type": "style",
      "uri": "plg_fields_plupload/jquery-ui.min.css"
    },
    {
      "name": "plg_fields_plupload.ui.style",
      "type": "style",
      "uri": "plg_fields_plupload/jquery.ui.plupload.css",
      "dependencies": ["plg_fields_plupload.jquery-ui.style"]
    },
    {
      "name": "plg_fields_plupload.jquery-ui",
      "type": "script",
      "uri": "plg_fields_plupload/jquery-ui.min.js",
      "dependencies": ["jquery"]
    },
    {
      "name": "plg_fields_plupload.core",
      "type": "script",
      "uri": "plg_fields_plupload/plupload.full.min.js"
