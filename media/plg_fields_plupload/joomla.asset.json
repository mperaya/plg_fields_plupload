      "uri": "plg_fields_plupload/plupload-single.js",
      "version": "3.0.0",
      "dependencies": ["plg_fields_plupload.field", "plg_fields_plupload.script"]
    },
    {
      "name": "plg_fields_plupload.multiple",
      "type": "script",
      "uri": "plg_fields_plupload/plupload-multiple.js",
      "version": "3.0.0",
      "dependencies": ["plg_fields_plupload.field", "plg_fields_plupload.script"]
    }
  ]
