<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="fieldparams">
			<fieldset name="fieldparams">
				<field
					name="storage_mode"
					type="list"
					label="PLG_FIELDS_PLUPLOAD_PARAMS_STORAGE_MODE_LABEL"
					description="PLG_FIELDS_PLUPLOAD_PARAMS_STORAGE_MODE_DESC"
					default="legacy"
				>
					<option value="legacy">PLG_FIELDS_PLUPLOAD_STORAGE_LEGACY</option>
					<option value="media_manager">PLG_FIELDS_PLUPLOAD_STORAGE_MEDIA</option>
				</field>
				<field
					name="media_subpath"
					type="text"
					label="PLG_FIELDS_PLUPLOAD_PARAMS_MEDIA_SUBPATH_LABEL"
					description="PLG_FIELDS_PLUPLOAD_PARAMS_MEDIA_SUBPATH_DESC"
					default="plupload"
					showon="storage_mode:media_manager"
				/>
			<field
				name="upload_path"
				type="text"
				label="PLG_FIELDS_PLUPLOAD_PARAMS_UPLOAD_PATH_LABEL"
				description="PLG_FIELDS_PLUPLOAD_PARAMS_UPLOAD_PATH_DESC"
				class="col-md-10 input-large-text"
				default="/tmp"
				required="true"
				filter="path"
			/>
			<field
				name="multiple_uploads"
				type="radio"
				label="PLG_FIELDS_PLUPLOAD_PARAMS_MULTIPLE_UPLOADS_LABEL"
				description="PLG_FIELDS_PLUPLOAD_PARAMS_MULTIPLE_UPLOADS_DESC"
				class="btn-group btn-group-yesno"
				default="0"
			>
				<option value="1">JYES</option>
				<option value="0">JNO</option>
			</field>
			<field
				name="prevent_duplicates"
				type="checkbox"
				label="PLG_FIELDS_PLUPLOAD_PARAMS_PREVENT_DUPLICATES_LABEL"
				description="PLG_FIELDS_PLUPLOAD_PARAMS_PREVENT_DUPLICATES_DESC"
				value="true"
				checked="1"
				showon="multiple_uploads:1"
			/>
			<field
				name="upload_field"
				type="text"
				label="PLG_FIELDS_PLUPLOAD_PARAMS_UPLOAD_FIELD_LABEL"
				description="PLG_FIELDS_PLUPLOAD_PARAMS_UPLOAD_FIELD_DESC"
				class="col-md-10 input-large-text"
				default=""
				showon="multiple_uploads:0"
			/>
			<field
				name="mime_restriction"
				type="list"
				label="PLG_FIELDS_PLUPLOAD_PARAMS_MIME_RESTRICTION_LABEL"
				description="PLG_FIELDS_PLUPLOAD_PARAMS_MIME_RESTRICTION_DESC"
				default="joomla"
			>
				<option value="joomla">PLG_FIELDS_PLUPLOAD_MIME_RESTRICTION_JOOMLA</option>
				<option value="custom">PLG_FIELDS_PLUPLOAD_MIME_RESTRICTION_CUSTOM</option>
				<option value="both">PLG_FIELDS_PLUPLOAD_MIME_RESTRICTION_BOTH</option>
			</field>
			<field
				name="custom_check_mime"
				type="radio"
				label="PLG_FIELDS_PLUPLOAD_PARAMS_CUSTOM_CHECK_MIME_LABEL"
				description="PLG_FIELDS_PLUPLOAD_PARAMS_CUSTOM_CHECK_MIME_DESC"
				layout="joomla.form.field.radio.switcher"
				default="0"
				showon="mime_restriction:custom[OR]mime_restriction:both"
			>
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
			<field
				name="mime_types"
				type="subform"
				label="PLG_FIELDS_PLUPLOAD_PARAMS_MIME_TYPES_LABEL"
				description="PLG_FIELDS_PLUPLOAD_PARAMS_MIME_TYPES_DESC"
				multiple="true"
				translate_default="true"
				layout="joomla.form.field.subform.repeatable-table"
				default="PLG_FIELDS_PLUPLOAD_MIME_TYPES_DEFAULT"
				showon="mime_restriction:custom[OR]mime_restriction:both"
			>
				<form>
					<field
						name="title"
						type="text"
						label="PLG_FIELDS_PLUPLOAD_MULTIPLE_KEY"
						/>
					<field
						name="extensions"
						type="text"
						label="PLG_FIELDS_PLUPLOAD_MULTIPLE_VALUE"
						/>
						<field
							name="mime_types"
							type="text"
							label="PLG_FIELDS_PLUPLOAD_MIME_TYPES_VALUE"
							showon="custom_check_mime:1"
							/>
				</form>
			</field>
			<field
				name="max_file_size"
				type="number"
				label="PLG_FIELDS_PLUPLOAD_PARAMS_MAX_FILE_SIZE_LABEL"
				description="PLG_FIELDS_PLUPLOAD_PARAMS_MAX_FILE_SIZE_DESC"
				class="col-md-2"
				default="0"
			/>
			<field
				name="spacer1"
				type="spacer"
				label="PLG_FIELDS_PLUPLOAD_PARAMS_WIDTH_LABEL"
				description="PLG_FIELDS_PLUPLOAD_PARAMS_WIDTH_DESC"
				hr="true"
			/>
			<field
				name="width"
				type="number"
				label="PLG_FIELDS_PLUPLOAD_PARAMS_WIDTH_LABEL"
				description="PLG_FIELDS_PLUPLOAD_PARAMS_WIDTH_DESC"
				default=""
				class="col-md-2"
			/>
			<field
				name="height"
				type="number"
				label="PLG_FIELDS_PLUPLOAD_PARAMS_HEIGHT_LABEL"
				description="PLG_FIELDS_PLUPLOAD_PARAMS_HEIGHT_DESC"
				default=""
				class="col-md-2"
			/>
			<field
				name="upload_groups"
				type="usergrouplist"
				label="PLG_FIELDS_PLUPLOAD_PARAMS_UPLOAD_GROUPS_LABEL"
				description="PLG_FIELDS_PLUPLOAD_PARAMS_UPLOAD_GROUPS_DESC"
				multiple="multiple"
			/>
			<field
				name="download_groups"
				type="usergrouplist"
				label="PLG_FIELDS_PLUPLOAD_PARAMS_DOWNLOAD_GROUPS_LABEL"
				description="PLG_FIELDS_PLUPLOAD_PARAMS_DOWNLOAD_GROUPS_DESC"
				multiple="multiple"
			/>
		</fieldset>
	</fields>
</form>
